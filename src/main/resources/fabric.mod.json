{
  "schemaVersion": 1,
  "id": "beachparty",
  "version": "${version}",
  "name": "[Let's Do] Beachparty",
  "description": "Take a break - build sandcastles, drink cocktails and enjoy your Minecraft Session.",
  "authors": [
    "Satisfy"
  ],
  "contributors": [
    "MissLilitu, Iri, Dev_Myst"
  ],
  "contact": {
    "homepage": "https://github.com/satisfyu/Beachparty",
    "issues": "https://github.com/satisfyu/Let-s-Do-Hub"
  },
  "license": "Custom",
  "icon": "pack.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "net.satisfy.beachparty.Beachparty"
    ],
    "client": [
      "net.satisfy.beachparty.client.BeachpartyClient"
    ],
    "modmenu": [
      "net.satisfy.beachparty.core.config.ModMenuIntegration"
    ]
  },
  "mixins": [
    "beachparty.mixins.json"
  ],
  "accessWidener": "beachparty.accesswidener",
  "depends": {
    "fabricloader": ">=0.19.0",
    "fabric-api": "*",
    "minecraft": "~26.2",
    "java": ">=25",
    "accessories": "*",
    "cloth-config": "*"
  },
  "suggests": {
    "modmenu": "*"
  }
}
